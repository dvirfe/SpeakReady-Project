@* תחנה במסלול התלמיד. המצב הוא עיצוב בלבד: completed, current או upcoming. *@
<article class="sr-stop @State">
    <div class="sr-marker" aria-hidden="true">@Number</div>
    <div class="sr-stop-card">
        <span class="sr-badge">@Status</span>
        <h3>@Title</h3>
        <p>@Description</p>
        <a class="sr-text-link" href="@Href">@LinkText <span aria-hidden="true">←</span>
</a>
    </div>
</article>

@code {
    [Parameter] public string Number { get; set; } = string.Empty;
    [Parameter] public string State { get; set; } = "upcoming";
    [Parameter] public string Status { get; set; } = string.Empty;
    [Parameter] public string Title { get; set; } = string.Empty;
    [Parameter] public string Description { get; set; } = string.Empty;
    [Parameter] public string Href { get; set; } = "/student/lesson";
    [Parameter] public string LinkText { get; set; } = "לצפייה בתרגול לדוגמה";
}

