@inject UserSession Session
@inject NavigationManager Navigation
@if (ready && Session.IsLoggedIn && Session.Role == AllowedRole) { @ChildContent }
@code {
    [Parameter] public UserRole AllowedRole { get; set; }
    [Parameter] public RenderFragment? ChildContent { get; set; }
    private bool ready;
    protected override async Task OnParametersSetAsync()
    {
        await Session.InitializeAsync();
        ready = true;
        if (!Session.IsLoggedIn) Navigation.NavigateTo("/login", forceLoad: true);
        else if (Session.Role != AllowedRole) Navigation.NavigateTo("/access-denied");
    }
}
