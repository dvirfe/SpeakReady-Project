@page "/login"
@using System.Net
@using System.Net.Http.Json
@using Model
@using System.Text.Json.Serialization
@using System.Text.Json
@inject HttpClient Http
@inject UserSession Session
@inject NavigationManager Navigation

<PageTitle>כניסה | SpeakReady</PageTitle>

<section class="auth-section">
    <div class="container">
        <div class="row g-5 align-items-center justify-content-center">

            <div class="col-lg-5 auth-intro">
                <span class="eyebrow">WELCOME BACK</span>
                <h1>
                    כל ניסיון<br />
                    מוסיף <span class="highlight-word">ביטחון.</span>
                </h1>
                <p class="lead mt-4">
                    ממשיכים מהנקודה שלכם.<br />
                    לומדים עוד קצת. אומרים עוד משפט.
                </p>
                <div class="auth-quote" lang="en" dir="ltr">
                    Your voice.<br />
                    Your pace.<br />
                    <em>Your progress.</em>
                </div>
            </div>

            <div class="col-md-9 col-lg-5">
                <div class="auth-card card border-0">
                    <div class="card-body p-4 p-md-5">

                        <span class="small text-secondary">
                            שמחים לראות אתכם
                        </span>
                        <h2 class="h3 mt-2 mb-4">כניסה לחשבון</h2>

                        <div role="form" aria-describedby="login-stage">

                            <Field Id="login-username"
                                   Label="שם משתמש או דואר אלקטרוני"
                                   Dir="ltr"
                                   Placeholder="name@example.com"
                                   Autocomplete="username"
                                   MaxLength="254"
                                   @bind-Value="username" />

                            <Field Id="login-password"
                                   Label="סיסמה"
                                   Type="password"
                                   Dir="ltr"
                                   Autocomplete="current-password"
                                   MaxLength="128"
                                   @bind-Value="password" />

                            <button type="button"
                                    class="btn btn-primary btn-lg w-100 mt-3"
                                    disabled="@isBusy"
                                    @onclick="LoginAsync">
                                @(isBusy ? "מתחבר..." : "כניסה")
                                <span aria-hidden="true">←</span>
                            </button>
                        </div>

                        @if (!string.IsNullOrEmpty(errorMessage))
                        {
                            <p id="login-stage"
                               class="small text-danger mt-3 mb-0"
                               role="alert">
                                @errorMessage
                            </p>
                        }
                        else
                        {
                            <p id="login-stage"
                               class="small text-secondary mt-3 mb-0">
                                הזינו את פרטי החשבון כדי להמשיך.
                            </p>
                        }

                    </div>
                </div>

                <p class="text-center mt-4">
                    עדיין אין לכם חשבון?
                    <a class="text-link" href="/register">
                        יוצרים חשבון כאן
                    </a>
                </p>
            </div>

        </div>
    </div>
</section>

@code {
    private string? username;
    private string? password;
    private string? errorMessage;
    private bool isBusy;

    private async Task LoginAsync()
    {
        errorMessage = null;

        if (string.IsNullOrWhiteSpace(username) ||
            string.IsNullOrWhiteSpace(password))
        {
            errorMessage = "יש למלא שם משתמש וסיסמה.";
            return;
        }

        isBusy = true;

        try
        {
            var credentials = new
            {
                Username = username.Trim(),
                Password = password
            };

            using HttpResponseMessage response =
                await Http.PostAsJsonAsync(
                    "api/users/login", credentials);

            if (response.StatusCode == HttpStatusCode.Unauthorized)
            {
                errorMessage = "שם המשתמש או הסיסמה שגויים.";
                return;
            }

            if (!response.IsSuccessStatusCode)
            {
                errorMessage = "הכניסה נכשלה. נסו שוב.";
                return;
            }

            var jsonOptions = new JsonSerializerOptions(JsonSerializerDefaults.Web);
            jsonOptions.Converters.Add(new JsonStringEnumConverter());

            User? user =
                await response.Content.ReadFromJsonAsync<User>(jsonOptions);

            if (user == null)
            {
                errorMessage = "הכניסה נכשלה. נסו שוב.";
                return;
            }

            Session.Login(user);
        }
        catch (HttpRequestException)
        {
            errorMessage = "השרת לא זמין כרגע. נסו שוב בעוד רגע.";
            return;
        }
        finally
        {
            isBusy = false;
        }

        Navigation.NavigateTo("/");
    }
}
