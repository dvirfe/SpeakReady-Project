@page "/login"
<PageTitle>כניסה | SpeakReady</PageTitle>
<section class="auth-section container">
    <div class="auth-card card border-0 mx-auto" style="max-width: 32rem">
        <div class="card-body p-4 p-md-5">
            <span class="eyebrow">WELCOME BACK</span>
            <h1 class="h2">ממשיכים לתרגל.</h1>
            @if (!string.IsNullOrEmpty(Error))
            {
                <p class="alert alert-danger" role="alert">@(Error == "invalid" ? "פרטי הכניסה שגויים או שהחשבון אינו פעיל." : "לא ניתן להתחבר כרגע. נסו שוב בעוד רגע.")</p>
            }
            <form method="post" action="/account/login" data-enhance="false">
                <AntiforgeryToken />
                <label class="form-label" for="username">שם משתמש או דואר אלקטרוני</label>
                <input class="form-control mb-3" id="username" name="Username" dir="ltr" autocomplete="username" required maxlength="254" />
                <label class="form-label" for="password">סיסמה</label>
                <input class="form-control mb-3" id="password" name="Password" type="password" dir="ltr" autocomplete="current-password" required maxlength="72" />
                <button class="btn btn-primary w-100" type="submit">כניסה</button>
            </form>
            <p class="mt-4 mb-0">אין חשבון? <a href="/register">יוצרים חשבון תלמיד</a></p>
        </div>
    </div>
</section>
@code { [SupplyParameterFromQuery] public string? Error { get; set; } }
