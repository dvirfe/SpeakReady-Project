@page "/student/practice/{ExerciseId:int}"
@inject ApiClient Api
<PageTitle>תרגול | SpeakReady</PageTitle>
<RoleArea AllowedRole="UserRole.Student">
    <div class="container py-5">
        <a href="/student">חזרה לתרגילים ולהיסטוריה</a>
        @if (error is not null) { <p class="alert alert-warning mt-3" role="alert">@error</p> }
        else if (exercise is null) { <p role="status">טוענים את התרגיל...</p> }
        else
        {
            <InnerHeading Eyebrow="מקום לקול שלך" Title="@exercise.Title" Description="@exercise.Instructions" />
            <article class="sr-panel mb-4"><h2 lang="en" dir="ltr">@exercise.PromptText</h2></article>
            <AudioRecorder @key="ExerciseId" ExerciseId="ExerciseId" MaxSeconds="exercise.MaxSeconds" />
        }
    </div>
</RoleArea>
@code {
    [Parameter] public int ExerciseId { get; set; }
    private ExerciseSummary? exercise;
    private string? error;
    protected override async Task OnParametersSetAsync()
    {
        error = null; exercise = null;
        try { exercise = (await Api.GetAsync<List<ExerciseSummary>>("api/practice/exercises"))?.Find(e => e.Id == ExerciseId); if (exercise is null) error = "התרגיל לא נמצא."; }
        catch (Exception ex) when (ex is HttpRequestException or TaskCanceledException) { error = "לא ניתן לטעון את התרגיל. נסו שוב או התחברו מחדש."; }
    }
}
