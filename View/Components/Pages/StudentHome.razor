@page "/student"
@inject ApiClient Api
<PageTitle>התרגול שלי | SpeakReady</PageTitle>
<RoleArea AllowedRole="UserRole.Student">
    <div class="container py-5">
        <InnerHeading Eyebrow="מתקדמים בקצב שלך" Title="עוד תשובה. עוד ביטחון." Description="בוחרים שאלה, מקליטים באנגלית ולומדים מהמשוב." />
        @if (error is not null) { <p class="alert alert-warning" role="alert">@error <a href="/login">כניסה מחדש</a></p> }
        else if (exercises is null || history is null) { <p role="status">טוענים את התרגילים...</p> }
        else
        {
            <div class="row g-3 mb-4">
                <div class="col-md-4"><SummaryCard Label="תרגילים עם משוב" Value="@completed.ToString()" Note="לפי הניסיונות האחרונים שלך" /></div>
                <div class="col-md-4"><SummaryCard Label="ניתוחים שנותרו היום" Value="@Math.Max(0, history.DailyLimit - history.UsedToday).ToString()" Note="המכסה מתחדשת בחצות UTC" /></div>
            </div>
            <div class="row g-3">
                @foreach (var exercise in exercises)
                {
                    <div class="col-md-4"><article class="sr-panel h-100">
                        <h2>@exercise.Title</h2><p>@exercise.Instructions</p>
                        <a class="btn btn-primary" href="@($"/student/practice/{exercise.Id}")">לתרגול</a>
                    </article></div>
                }
            </div>
            <h2 class="mt-5">הניסיונות שלי</h2>
            @if (history.Attempts.Count == 0) { <p>כאן יופיעו התשובות והמשובים שלך לאחר התרגול הראשון.</p> }
            else
            {
                <p class="small">עד 100 הניסיונות האחרונים.</p>
                <div class="sr-table-wrap"><table class="table sr-table">
                    <thead><tr><th>תרגיל</th><th>מועד (שעון ישראל)</th><th>מצב</th><th>משוב</th></tr></thead>
                    <tbody>@foreach (var attempt in history.Attempts)
                    { <tr><td>@attempt.Title</td><td>@attempt.SubmittedAt.ToIsraelTime().ToString("dd/MM/yyyy HH:mm")</td><td>@attempt.AnalysisStatus.ToHebrew()</td><td><a href="@($"/student/report/{attempt.Id}")">לפתיחת הניסיון</a></td></tr> }</tbody>
                </table></div>
            }
        }
    </div>
</RoleArea>
@code {
    private List<ExerciseSummary>? exercises;
    private PracticeHistory? history;
    private string? error;
    private int completed => history?.Attempts.Where(a => a.AnalysisStatus == AnalysisState.Completed).Select(a => a.ExerciseId).Distinct().Count() ?? 0;
    protected override async Task OnInitializedAsync()
    {
        try { exercises = await Api.GetAsync<List<ExerciseSummary>>("api/practice/exercises"); history = await Api.GetAsync<PracticeHistory>("api/practice/history"); }
        catch (Exception ex) when (ex is HttpRequestException or TaskCanceledException) { error = "לא ניתן לטעון את הנתונים כרגע. אם החיבור פג, התחברו מחדש."; }
    }
}
