@page "/register"
@rendermode @(new Microsoft.AspNetCore.Components.Web.InteractiveServerRenderMode(prerender: false))
@using System.Net.Http.Json
@using System.Net.Mail
@using System.Text.Json
@implements IDisposable
@inject HttpClient Http
@inject NavigationManager Navigation

<PageTitle>הרשמה | SpeakReady</PageTitle>

<section class="auth-section">
    <div class="container">
        <div class="row g-5 align-items-center justify-content-center">

            <div class="col-lg-5 auth-intro">
                <span class="eyebrow">LET'S FIND YOUR VOICE</span>

                <h1>
                    הצעד הראשון<br />
                    מתחיל <span class="highlight-word">כאן.</span>
                </h1>

                <p class="lead mt-4">
                    מסלול אישי לתרגול אנגלית,<br />
                    עם מקום ללמוד ולהשתפר.
                </p>

                <ul class="auth-benefits list-unstyled">
                    <li><span>01</span> לומדים בקצב שמתאים לכם</li>
                    <li><span>02</span> מתרגלים תשובות עם משמעות</li>
                    <li><span>03</span> מצטרפים למורה כשרוצים</li>
                </ul>
            </div>

            <div class="col-md-9 col-lg-5">
                <div class="auth-card card border-0">
                    <div class="card-body p-4 p-md-5">

                        <span class="small text-secondary">נעים להכיר</span>
                        <h2 class="h3 mt-2 mb-4">יוצרים חשבון תלמיד</h2>

                        @if (errorMessage is not null)
                        {
                            <div class="alert alert-danger" role="alert">
                                @errorMessage
                            </div>
                        }

                        @if (isRegistered)
                        {
                            <div class="alert alert-success" role="status">
                                <strong>ההרשמה הצליחה!</strong>
                                עוברים לדף הכניסה בעוד @secondsLeft שניות.
                            </div>
                        }

                        <div role="form" aria-label="הרשמה">
                            <fieldset disabled="@(isBusy || isRegistered)"
                                      class="border-0 p-0 m-0 w-100">

                                <Field Id="reg-name"
                                       Label="שם מלא"
                                       Placeholder="איך קוראים לכם?"
                                       Autocomplete="name"
                                       MaxLength="100"
                                       @bind-Value="fullName" />

                                <Field Id="reg-username"
                                       Label="שם משתמש"
                                       Dir="ltr"
                                       Placeholder="your_username"
                                       Autocomplete="username"
                                       MaxLength="50"
                                       @bind-Value="username" />

                                <Field Id="reg-email"
                                       Label="כתובת דואר אלקטרוני"
                                       Type="email"
                                       Dir="ltr"
                                       Placeholder="name@example.com"
                                       Autocomplete="email"
                                       @bind-Value="email" />

                                <Field Id="reg-password"
                                       Label="סיסמה"
                                       Type="password"
                                       Dir="ltr"
                                       Autocomplete="new-password"
                                       MaxLength="128"
                                       @bind-Value="password" />

                                <Field Id="reg-confirm"
                                       Label="אימות סיסמה"
                                       Type="password"
                                       Dir="ltr"
                                       Autocomplete="new-password"
                                       MaxLength="128"
                                       @bind-Value="confirmPassword" />

                                <button type="button"
                                        class="btn btn-primary btn-lg w-100 mt-3"
                                        disabled="@(isBusy || isRegistered)"
                                        @onclick="RegisterAsync">
                                    @(isBusy ? "בודקים..." : "יוצרים חשבון")
                                    <span aria-hidden="true">←</span>
                                </button>

                            </fieldset>
                        </div>
                    </div>
                </div>

                <p class="text-center mt-4">
                    כבר יש לכם חשבון?
                    <a class="text-link" href="/login">נכנסים כאן</a>
                </p>
            </div>

        </div>
    </div>
</section>

@code {
    private string? fullName = "";
    private string? username = "";
    private string? email = "";
    private string? password = "";
    private string? confirmPassword = "";

    private string? errorMessage;
    private bool isBusy;
    private bool isRegistered;
    private int secondsLeft = 5;

    private readonly CancellationTokenSource cancellation = new();

    private async Task RegisterAsync()
    {
        if (isBusy || isRegistered)
            return;

        errorMessage = null;

        if (string.IsNullOrWhiteSpace(fullName) ||
            string.IsNullOrWhiteSpace(username) ||
            string.IsNullOrWhiteSpace(email) ||
            string.IsNullOrWhiteSpace(password) ||
            string.IsNullOrWhiteSpace(confirmPassword))
        {
            errorMessage = "יש למלא את כל השדות.";
            return;
        }

        string cleanFullName = fullName.Trim();
        string cleanUsername = username.Trim();
        string cleanEmail = email.Trim();

        if (!MailAddress.TryCreate(cleanEmail, out var address) ||
            address.Address != cleanEmail)
        {
            errorMessage = "כתובת האימייל לא תקינה.";
            return;
        }

        if (password != confirmPassword)
        {
            errorMessage = "הסיסמה ואימות הסיסמה לא זהים.";
            return;
        }

        isBusy = true;
        CancellationToken token = cancellation.Token;

        try
        {
            // שלב הקריאה: בדיקה אם שם המשתמש כבר קיים.
            bool usernameExists = await Http.GetFromJsonAsync<bool>(
                $"api/users/username-exists?username={Uri.EscapeDataString(cleanUsername)}",
                token);

            if (usernameExists)
            {
                errorMessage = "שם המשתמש כבר תפוס. בחרו שם אחר.";
                return;
            }

            // בדיקה אם כתובת האימייל כבר קיימת.
            bool emailExists = await Http.GetFromJsonAsync<bool>(
                $"api/users/email-exists?email={Uri.EscapeDataString(cleanEmail)}",
                token);

            if (emailExists)
            {
                errorMessage = "האימייל הזה כבר רשום במערכת.";
                return;
            }

            // שלב הכתיבה: שליחת השדות שה-API מצפה לקבל.
            var request = new
            {
                Username = cleanUsername,
                FullName = cleanFullName,
                Email = cleanEmail,
                Password = password
            };

            using HttpResponseMessage response =
                await Http.PostAsJsonAsync("api/users", request, token);

            if (!response.IsSuccessStatusCode)
            {
                errorMessage = await ReadErrorAsync(response, token);
                return;
            }

            isRegistered = true;
            password = "";
            confirmPassword = "";
            secondsLeft = 5;

            while (secondsLeft > 0)
            {
                StateHasChanged();
                await Task.Delay(1000, token);
                secondsLeft--;
            }

            Navigation.NavigateTo("/login");
        }
        catch (OperationCanceledException)
        {
            if (!cancellation.IsCancellationRequested)
            {
                errorMessage = "השרת לא הגיב בזמן. נסו שוב.";
            }
        }
        catch (HttpRequestException)
        {
            errorMessage = "לא ניתן להשלים את הבקשה. ודאו שה־API פועל ונסו שוב.";
        }
        catch (JsonException)
        {
            errorMessage = "התקבלה תשובה לא צפויה מהשרת.";
        }
        finally
        {
            isBusy = false;
        }
    }

    private static async Task<string> ReadErrorAsync(
        HttpResponseMessage response,
        CancellationToken token)
    {
        string fallback = response.StatusCode == System.Net.HttpStatusCode.Conflict
            ? "שם המשתמש או כתובת האימייל כבר רשומים."
            : "ההרשמה נכשלה. בדקו את הפרטים ונסו שוב.";

        string content = await response.Content.ReadAsStringAsync(token);

        if (string.IsNullOrWhiteSpace(content))
            return fallback;

        try
        {
            using JsonDocument document = JsonDocument.Parse(content);
            JsonElement root = document.RootElement;

            if (root.ValueKind != JsonValueKind.Object)
                return fallback;

            // הודעת שגיאה שמוחזרת במפורש מה-Controller.
            if (root.TryGetProperty("message", out JsonElement message) &&
                message.ValueKind == JsonValueKind.String)
            {
                return message.GetString() ?? fallback;
            }

            // שגיאות אימות אוטומטיות של CreateUserRequest.
            if (root.TryGetProperty("errors", out JsonElement errors) &&
                errors.ValueKind == JsonValueKind.Object)
            {
                var messages = new List<string>();

                foreach (JsonProperty property in errors.EnumerateObject())
                {
                    if (property.Value.ValueKind != JsonValueKind.Array)
                        continue;

                    foreach (JsonElement item in property.Value.EnumerateArray())
                    {
                        if (item.ValueKind == JsonValueKind.String &&
                            item.GetString() is string text)
                        {
                            messages.Add(text);
                        }
                    }
                }

                if (messages.Count > 0)
                    return string.Join(" ", messages);
            }
        }
        catch (JsonException)
        {
            return fallback;
        }

        return fallback;
    }

    public void Dispose()
    {
        cancellation.Cancel();
        cancellation.Dispose();
    }
}