@inherits LayoutComponentBase
@implements IDisposable
@inject UserSession Session
@inject NavigationManager Navigation

<div class="site-theme" data-bs-theme="@(isDarkMode ? "dark" : null)">
<a class="skip-link" href="#main-content">דילוג לתוכן</a>

<header class="site-header">
    <nav class="container d-flex align-items-center justify-content-between gap-3 py-3"
         aria-label="ניווט ראשי">

        <a class="brand-link" href="/" aria-label="SpeakReady - דף הבית">
            <Logo />
        </a>

        <div class="nav-links d-none d-lg-flex gap-4">
            <a href="/#how-it-works">איך זה עובד</a>
            <a href="/#learning-path">מסלול הלמידה</a>
            <a href="/privacy">פרטיות והקלטות</a>
        </div>

        <div class="d-flex align-items-center gap-2">

            <button type="button" class="theme-toggle" @onclick="ToggleTheme">
                @(isDarkMode ? "מעבר למצב בהיר" : "מעבר למצב כהה")
            </button>

            @if (Session.IsLoggedIn)
            {
                @if (Session.Role == Model.UserRole.Student)
                {
                    <a class="login-link" href="/student">אזור תלמיד</a>
                }
                else if (Session.Role == Model.UserRole.Teacher)
                {
                    <a class="login-link" href="/pilot-info">אזור מורה</a>
                }
                else if (Session.Role == Model.UserRole.Admin)
                {
                    <a class="login-link" href="/pilot-info">אזור מנהל</a>
                }
                <span class="fw-semibold">
                    שלום, @Session.Username
                </span>

                <form method="post" action="/account/logout" data-enhance="false">
                    <AntiforgeryToken />
                    <button type="submit" class="btn btn-outline-primary">התנתקות</button>
                </form>
            }
            else
            {
                <a class="login-link" href="/login">
                    כניסה
                </a>

                <a class="btn btn-primary nav-cta" href="/register">
                    מתחילים לתרגל
                    <span aria-hidden="true">↖</span>
                </a>
            }

        </div>
    </nav>
</header>

<main id="main-content">
    @Body
</main>

<footer class="site-footer">
    <div class="container py-4 d-flex flex-wrap justify-content-between align-items-center gap-3">
        <Logo Compact="true" />
        <p class="m-0 small">
            צעד קטן בתרגול. יותר ביטחון בדיבור.
        </p>
        <span class="small">
            פרויקט גמר בהנדסת תוכנה · דביר · 2026
        </span>
    </div>
</footer>

<div id="blazor-error-ui" role="alert">
    החיבור לאתר נותק.
    <a href="" class="reload">טעינה מחדש</a>
    <button class="dismiss" aria-label="סגירת ההודעה">×</button>
</div>
</div>  
@code {
    private bool isDarkMode = false;

    private void ToggleTheme()
    {
        isDarkMode = !isDarkMode;
    }
    protected override async Task OnInitializedAsync()
    {
        Session.OnChange += OnSessionChanged;
        await Session.InitializeAsync();
    }

    private void OnSessionChanged()
    {
        _ = InvokeAsync(StateHasChanged);
    }

    public void Dispose()
    {
        Session.OnChange -= OnSessionChanged;
    }
}
